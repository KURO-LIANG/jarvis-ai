# ==================== LLM (OpenAI-compatible API) ====================
# Provider identifier for logging (e.g. "openai")
# LLM_PROVIDER=openai

# API key for the LLM service
LLM_API_KEY=your_api_key_here

# Base URL of the OpenAI-compatible endpoint
# DeepSeek:  https://api.deepseek.com/v1
# MiniMax:   https://api.minimaxi.com/v1
# OpenAI:    https://api.openai.com/v1
# LM Studio: http://127.0.0.1:1234/v1
# Ollama:    http://127.0.0.1:11434/v1
# LLM_BASE_URL=https://api.minimaxi.com/v1

# Model name
# LLM_MODEL=MiniMax-M3

# Max tokens and temperature (optional)
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.7

# OMLX server - local ASR/TTS (required)
OMLX_API_KEY=your_api_key_here
# OMLX_BASE_URL=http://127.0.0.1:8000

# Conversation mode: "llm" (LLM via OpenAI-compatible API) or "tts" (Qwen3-TTS direct, no LLM needed)
CONVERSATION_MODE=llm

# Speech provider: "qwen" (OMLX local TTS) or "minimax" (MiniMax T2A v2 API)
# When set to "minimax", SPEECH_API_KEY is required
# SPEECH_PROVIDER=qwen
# SPEECH_API_KEY=your_api_key_here

# MiniMax T2A v2 endpoint — full URL (change this to switch APIs)
# MINIMAX_SPEECH_URL=https://api.minimaxi.com/v1/t2a_v2

# MiniMax speech model
# Available models: speech-2.8-hd, speech-2.8-turbo, speech-2.6-hd, speech-2.6-turbo,
#   speech-02-hd, speech-02-turbo, speech-01-hd, speech-01-turbo
# MINIMAX_SPEECH_MODEL=speech-2.8-turbo

# MiniMax speech mode: "stream" (SSE streaming) or "normal" (single response)
# MINIMAX_SPEECH_MODE=stream

# MiniMax T2A voice settings
# MINIMAX_SPEECH_VOICE_ID=male-qn-qingse
# MINIMAX_SPEECH_SPEED=1.0
# MINIMAX_SPEECH_VOL=1.0
# MINIMAX_SPEECH_PITCH=0
# MINIMAX_SPEECH_EMOTION=happy

# MiniMax T2A audio output settings
# MINIMAX_SPEECH_AUDIO_FORMAT=mp3
# MINIMAX_SPEECH_SAMPLE_RATE=32000
# MINIMAX_SPEECH_BITRATE=128000
# MINIMAX_SPEECH_CHANNEL=1

# System prompt for LLM conversation mode (optional)
# SYSTEM_PROMPT=You are Jarvis, a helpful AI voice assistant. Keep responses concise and conversational. Limit responses to 2-3 sentences when possible.

# Interjection tags — MiniMax T2A renders tags like (laughs) (sighs) etc. as non-verbal sounds
# INTERJECTION_ENABLED=true
# INTERJECTION_PROMPT=You may insert interjection tags in your responses to make the speech more expressive and natural. Available tags: (laughs) laugh, (chuckle) light laugh, (coughs) cough, (clear-throat) clear throat, (groans) groan, (breath) normal breath, (pant) panting, (inhale) inhale, (exhale) exhale, (gasps) gasp, (sniffs) sniff, (sighs) sigh, (snorts) snort, (burps) burp, (lip-smacking) lip smack, (humming) humming, (hissing) hiss, (emm) hesitation umm, (sneezes) sneeze. Insert tags naturally where appropriate, e.g. "今天真是(sighs)太累了" or "(laughs)这个笑话真有趣".

# Debug mode - skip microphone, use text input (optional)
# DEBUG_MODE=true

# Wake words — strict exact/prefix match, no substring/fuzzy matching
# WAKE_WORDS=["jarvis","javis","贾维斯"]

# VAD (Voice Activity Detection)
# VAD_PROVIDER=silero  # "silero" or "webrtc"
# SILERO_THRESHOLD=0.5
# SILERO_MIN_SPEECH_MS=300
# SILERO_SILENCE_MS=800
# CONVERSATION_TIMEOUT=30.0
# WAKE_BEEP_ENABLED=true
# TIMEOUT_BEEP_ENABLED=true

# Voice commands — say any of these to exit conversation mode
# EXIT_COMMANDS=["退出","结束","停止","拜拜","再见"]
# INTERRUPT_COMMANDS=["停止","停一下","打断","闭嘴"]

# Memory — short-term (recent turns) + long-term (summary memory, persisted to disk)
# Disable with MEMORY_ENABLED=false
# MEMORY_ENABLED=true
# MEMORY_MAX_TURNS=10
# MEMORY_AUTO_EXTRACT=true
# MEMORY_STORAGE_PATH=~/.jarvis/memory
